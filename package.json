{
  "name": "appmozo",
  "version": "1.7.1v",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:offline": "expo start --offline",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk:preview": "npx --yes eas-cli build --platform android --profile preview",
    "build:apk:production": "npx --yes eas-cli build --platform android --profile production",
    "build:ios:iphone": "npx --yes eas-cli build --platform ios --profile iphone",
    "eas-build-post-install": "node -e \"require('fs').rmSync('android/build',{recursive:true,force:true});require('fs').rmSync('android/.gradle',{recursive:true,force:true});\"",
    "update:preview": "npx --yes eas-cli update --channel preview",
    "update:production": "npx --yes eas-cli update --channel production"
  },
